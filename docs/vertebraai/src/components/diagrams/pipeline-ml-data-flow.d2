direction: right

# ══════════════════════════════════════════════════════════════════════
# FASE 1  ·  ENTRADA Y PREPROCESAMIENTO
# direction: down → pasos apilados verticalmente (columna)
# ══════════════════════════════════════════════════════════════════════
fase1: "FASE 1  ·  ENTRADA Y PREPROCESAMIENTO" {
  direction: down
  style.fill: "#EBF5FB"
  style.stroke: "#1565C0"
  style.stroke-width: 2
  style.border-radius: 14
  style.font-color: "#1565C0"
  style.bold: true
  style.font-size: 14

  p1: "(1)  Radiografia de Columna\n──────────────────────────\n\n  [ DICOM / PNG ]\n\n   ||| ||| |||\n   Columna vertebral\n\n  Resolucion original" {
    shape: rectangle
    style.fill: "#BBDEFB"
    style.stroke: "#1565C0"
    style.stroke-width: 2
    style.border-radius: 10
    style.font-size: 13
  }

  p2: "(2)  Preprocesamiento\n──────────────────────\n\n [■■■■■] → 1024px  MedSAM\n\n [======]  Norm. percentiles\n\n Resize + normalize" {
    shape: rectangle
    style.fill: "#90CAF9"
    style.stroke: "#1565C0"
    style.stroke-width: 2
    style.border-radius: 10
    style.font-size: 13
  }

  p1 -> p2: "imagen raw" {
    style.border-radius: 0
    style.stroke: "#1565C0"
    style.font-size: 11
  }
}

# ══════════════════════════════════════════════════════════════════════
# FASE 2  ·  DETECCION DE VERTEBRAS
# direction: down → 4 pasos apilados verticalmente (columna)
# ══════════════════════════════════════════════════════════════════════
fase2: "FASE 2  ·  DETECCION DE VERTEBRAS" {
  direction: down
  style.fill: "#E0F2F1"
  style.stroke: "#00695C"
  style.stroke-width: 2
  style.border-radius: 14
  style.font-color: "#00695C"
  style.bold: true
  style.font-size: 14

  p3: "(3)  VertebraPrompt-Net\n───────────────────────\n\n  o─o─o─o─o\n  |   |   |\n  o─o─o─o─o\n\n IMG_SIZE=512  |  22 verts." {
    shape: rectangle
    style.fill: "#B2DFDB"
    style.stroke: "#00695C"
    style.stroke-width: 2
    style.border-radius: 10
    style.font-size: 13
  }

  p4: "(4)  Centros Vertebrales\n────────────────────────\n\n  ·  ←→  ·  ←→  ·\n  ↕              ↕\n  ·  ←→  ·  ←→  ·\n\n anchos / altos / offsets" {
    shape: rectangle
    style.fill: "#80CBC4"
    style.stroke: "#00695C"
    style.stroke-width: 2
    style.border-radius: 10
    style.font-size: 13
  }

  p5: "(5)  Seleccion Anatomica\n─────────────────────────\n\n  C1─C2─C3─···─T12\n      └──L1─L2─···─L5\n\n  Ruta vertebral coherente" {
    shape: rectangle
    style.fill: "#80CBC4"
    style.stroke: "#00695C"
    style.stroke-width: 2
    style.border-radius: 10
    style.font-size: 13
  }

  p6: "(6)  Cajas Iniciales\n────────────────────\n\n  ┌──┐  ┌──┐  ┌──┐\n  │C3│  │T6│  │L2│\n  └──┘  └──┘  └──┘\n\n  22 bboxes iniciales" {
    shape: rectangle
    style.fill: "#4DB6AC"
    style.stroke: "#00695C"
    style.stroke-width: 2
    style.border-radius: 10
    style.font-size: 13
  }

  p3 -> p4: "heatmaps + offsets" { style.border-radius: 0; style.stroke: "#00695C"; style.font-size: 11 }
  p4 -> p5: "centros detectados"  { style.border-radius: 0; style.stroke: "#00695C"; style.font-size: 11 }
  p5 -> p6: "ruta vertebral"      { style.border-radius: 0; style.stroke: "#00695C"; style.font-size: 11 }
}

# ══════════════════════════════════════════════════════════════════════
# FASE 3  ·  REFINAMIENTO DE CAJAS
# direction: down → pasos apilados verticalmente (columna)
# ══════════════════════════════════════════════════════════════════════
fase3: "FASE 3  ·  REFINAMIENTO DE CAJAS" {
  direction: down
  style.fill: "#FFF3E0"
  style.stroke: "#E65100"
  style.stroke-width: 2
  style.border-radius: 14
  style.font-color: "#E65100"
  style.bold: true
  style.font-size: 14

  p7: "(7)  Box Refiner\n──────────────────\n\n ┌─ ─ ─┐   ┌─────┐\n            →  │     │\n └─ ─ ─┘   └─────┘\n  inicial    refinada\n\n Ajuste fino anatomico" {
    shape: rectangle
    style.fill: "#FFCC80"
    style.stroke: "#E65100"
    style.stroke-width: 2
    style.border-radius: 10
    style.font-size: 13
  }

  p8: "(8)  Cajas Refinadas\n──────────────────────\n\n ┌──────┐  ┌──────┐\n │  C3  │  │  T6  │\n └──────┘  └──────┘\n ┌──────┐  ┌──────┐\n │  L2  │  │  L4  │\n └──────┘  └──────┘\n box_only | sin_pad" {
    shape: rectangle
    style.fill: "#FFA726"
    style.stroke: "#E65100"
    style.stroke-width: 2
    style.border-radius: 10
    style.font-size: 13
  }

  p7 -> p8: "boxes afinadas" { style.border-radius: 0; style.stroke: "#E65100"; style.font-size: 11 }
}

# ══════════════════════════════════════════════════════════════════════
# SALIDA
# ══════════════════════════════════════════════════════════════════════
salida: "SALIDA\n──────────\n 22 cajas\ndefinitivas\n\n ══► MedSAM\n     ViT-B" {
  shape: rectangle
  style.fill: "#BF360C"
  style.stroke: "#B71C1C"
  style.stroke-width: 3
  style.font-color: "#FFFFFF"
  style.border-radius: 10
  style.bold: true
  style.font-size: 14
}

# ──────────────────────────────────────────────────────────────────────
# CONEXIONES PRINCIPALES — contenedor a contenedor (líneas rectas)
# ──────────────────────────────────────────────────────────────────────
fase1 -> fase2: "tensor 512x512" {
  style.stroke: "#1565C0"
  style.stroke-width: 2
  style.font-color: "#1565C0"
  style.font-size: 12
  style.border-radius: 0
}

fase2 -> fase3: "bboxes iniciales" {
  style.stroke: "#00695C"
  style.stroke-width: 2
  style.font-color: "#00695C"
  style.font-size: 12
  style.border-radius: 0
}

fase3 -> salida: "22 cajas definitivas" {
  style.stroke: "#E65100"
  style.stroke-width: 4
  style.font-color: "#E65100"
  style.font-size: 12
  style.border-radius: 0
}

# ══════════════════════════════════════════════════════════════════════
# PESOS / CHECKPOINTS  (gris, cilindros)
# ══════════════════════════════════════════════════════════════════════
recursos: "PESOS / CHECKPOINTS" {
  direction: right
  style.fill: "#ECEFF1"
  style.stroke: "#78909C"
  style.stroke-width: 2
  style.border-radius: 10
  style.font-color: "#37474F"
  style.bold: true
  style.font-size: 13

  cp1: "vertebraprompt_net\nauxiliar_best.pt\n─────────────────\n  ~120 MB" {
    shape: cylinder
    style.fill: "#CFD8DC"
    style.stroke: "#546E7A"
    style.stroke-width: 2
    style.font-size: 12
  }

  cp2: "box_refiner\nbest.pt\n─────────────\n  ~45 MB" {
    shape: cylinder
    style.fill: "#CFD8DC"
    style.stroke: "#546E7A"
    style.stroke-width: 2
    style.font-size: 12
  }
}

recursos.cp1 -> fase2.p3: "carga pesos" {
  style.stroke: "#90A4AE"
  style.stroke-dash: 4
  style.stroke-width: 2
  style.font-color: "#546E7A"
  style.font-size: 11
  style.border-radius: 0
}

recursos.cp2 -> fase3.p7: "carga pesos" {
  style.stroke: "#90A4AE"
  style.stroke-dash: 4
  style.stroke-width: 2
  style.font-color: "#546E7A"
  style.font-size: 11
  style.border-radius: 0
}

# ══════════════════════════════════════════════════════════════════════
# LEYENDA
# ══════════════════════════════════════════════════════════════════════
leyenda: "LEYENDA" {
  direction: right
  style.fill: "#FAFAFA"
  style.stroke: "#BDBDBD"
  style.stroke-width: 1
  style.border-radius: 8
  style.font-size: 13
  style.bold: true

  l1: "Entrada y Preprocesamiento" {
    shape: rectangle
    style.fill: "#90CAF9"
    style.stroke: "#1565C0"
    style.stroke-width: 2
    style.border-radius: 6
    style.font-size: 12
  }
  l2: "Deteccion de Vertebras" {
    shape: rectangle
    style.fill: "#80CBC4"
    style.stroke: "#00695C"
    style.stroke-width: 2
    style.border-radius: 6
    style.font-size: 12
  }
  l3: "Refinamiento de Cajas" {
    shape: rectangle
    style.fill: "#FFA726"
    style.stroke: "#E65100"
    style.stroke-width: 2
    style.border-radius: 6
    style.font-size: 12
  }
  l4: "Pesos / Checkpoints" {
    shape: cylinder
    style.fill: "#CFD8DC"
    style.stroke: "#546E7A"
    style.stroke-width: 2
    style.font-size: 12
  }
}
