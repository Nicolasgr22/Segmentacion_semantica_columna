title: |md
  # Pipeline de Robustez — Notebook 07
  ## Flujo de ejecución real (no el orden de celdas)
| {
  near: top-center
  shape: text
}

shape: sequence_diagram

# ============ ACTORES ============
loop: "Loop principal\n(CELDA 16)" {
  shape: person
}
seg: "segmentar_paciente_crop\n(orquestador por paciente)"
fs: "Disco / FS\n(imágenes + máscaras GT)" {
  shape: cylinder
}
crop: "crop_imagen_y_mascara\n(simula recorte)"
vpn: "VertebraPromptNet\n(U-Net heatmap + WH + presence)"
br: "BoxRefiner\n(CNN ligera de deltas)"
shift: "mejor_shift_anatomico\n(realinear etiquetas)"
medsam: "MedSAM\n(SamPredictor)"
met: "Métricas\n(Dice / IoU)"

# ============ INICIO LOOP ============
loop -> loop: "for cfg in [baseline + 9 recortes]:\n  for modo in [auto, auto_norefiner, gt_box]:\n    for pid in pacientes_test:" {
  style.stroke: "#378ADD"
  style.bold: true
}

loop -> seg: "1. segmentar_paciente_crop(pid, split, ct, cb, prompt_mode)" {
  style.stroke: "#378ADD"
}

# ============ CARGA Y RECORTE (siempre) ============
seg -> fs: "2. resolver_paths_muestra(pid)" {
  style.stroke: "#999999"
}
fs -> seg: "img_o (RGB), mask_o (int32)" {
  style.stroke: "#999999"
}

seg -> crop: "3. crop_imagen_y_mascara(img, mask, ct, cb)" {
  style.stroke: "#378ADD"
}
crop -> crop: "recorta top%/bot%, reescala a 1024x1024,\nregistra vértebras eliminadas" {
  style.stroke: "#BA7517"
}
crop -> seg: "img_c, mask_c, info_corte" {
  style.stroke: "#639922"
}

# ============ RAMA SEGÚN PROMPT_MODE ============
seg -> seg: "4. switch(prompt_mode)" {
  style.stroke: "#378ADD"
  style.bold: true
}

# ----- RAMA AUTO -----
rama_auto: "RAMA: prompt_mode = 'auto' (pipeline completo)" {
  seg -> vpn: "5a. prompts_desde_imagen(img_c)" {
    style.stroke: "#378ADD"
  }
  vpn -> vpn: "predecir_outputs():\nforward → heat, class_heat, wh, off, presence" {
    style.stroke: "#378ADD"
  }
  vpn -> vpn: "extraer_picos(heat, top=90, dist=8)" {
    style.stroke: "#378ADD"
  }
  vpn -> vpn: "seleccionar_camino_dp:\nDP elige 17 picos coherentes con plantilla anatómica" {
    style.stroke: "#378ADD"
  }
  vpn -> vpn: "construir_prompts_desde_camino:\ncentro+wh → bbox 1024x1024 por vértebra" {
    style.stroke: "#378ADD"
  }
  vpn -> seg: "prompts_auto = {T1..L5: bbox_xyxy}" {
    style.stroke: "#639922"
  }

  seg -> br: "6a. refinar_prompts(prompts_auto, img_c)" {
    style.stroke: "#378ADD"
  }
  br -> br: "para cada bbox:\n recorta contexto 0.85, máscara binaria,\n forward → (dx,dy,dw,dh) con tanh acotado" {
    style.stroke: "#378ADD"
  }
  br -> br: "aplicar_delta_bbox con blend=0.80\n(corrige centro y escala)" {
    style.stroke: "#378ADD"
  }
  br -> seg: "prompts refinados (cajas más precisas)" {
    style.stroke: "#639922"
  }
}

# ----- RAMA AUTO_NOREFINER -----
rama_norefiner: "RAMA: prompt_mode = 'auto_norefiner' (mide aporte del refiner)" {
  seg -> vpn: "5b. prompts_desde_imagen(img_c)" {
    style.stroke: "#378ADD"
  }
  vpn -> seg: "prompts_auto SIN refinar" {
    style.stroke: "#BA7517"
  }
  seg -> seg: "(se omite BoxRefiner)" {
    style.stroke: "#BA7517"
  }
}

# ----- RAMA GT_BOX -----
rama_gt: "RAMA: prompt_mode = 'gt_box' (upper-bound)" {
  seg -> seg: "5c. para cada vértebra en mask_c:\n  bbox = bounding-box exacto del GT + margen 4px" {
    style.stroke: "#7F77DD"
  }
  seg -> seg: "prompts_gt = cajas perfectas\n(NO usa VertebraPromptNet ni BoxRefiner)" {
    style.stroke: "#7F77DD"
  }
}

# ============ POST-PROCESO COMÚN ============
seg -> shift: "7. mejor_shift_anatomico(prompts, mask_c)\n(solo en auto / auto_norefiner)" {
  style.stroke: "#378ADD"
}
shift -> shift: "prueba shifts -6..+6,\nelige el que maximiza IoU caja↔GT" {
  style.stroke: "#378ADD"
}
shift -> seg: "relabel_por_shift → prompts realineados" {
  style.stroke: "#639922"
}

seg -> medsam: "8. predictor.set_image(img_c)\npara cada bbox: predictor.predict(box=bbox)" {
  style.stroke: "#378ADD"
}
medsam -> medsam: "image encoder + prompt encoder\n+ mask decoder (multimask_output=False)" {
  style.stroke: "#378ADD"
}
medsam -> seg: "máscara binaria por vértebra + score" {
  style.stroke: "#639922"
}

seg -> met: "9. dice_iou_binario(pred, gt)\npor cada vértebra evaluada" {
  style.stroke: "#378ADD"
}
met -> met: "Dice/IoU estricto (mismo label)\n+ Dice flexible (mejor coincidencia)" {
  style.stroke: "#378ADD"
}
met -> seg: "DataFrame de filas (pid, vert, dice, iou, ...)" {
  style.stroke: "#639922"
}

seg -> loop: "10. df_paciente con métricas" {
  style.stroke: "#639922"
}

# ============ FIN LOOP ============
loop -> loop: "acumula df, repite siguiente pid/modo/cfg" {
  style.stroke: "#378ADD"
}
loop -> fs: "11. df_all.to_csv(robustez_vertebraprompt_detalle.csv)" {
  style.stroke: "#639922"
  style.bold: true
}
