# Servidor
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Modelo: pipeline VertebraPrompt + BoxRefiner + MedSAM (notebook 06)
MODEL_DEVICE=cpu
MEDSAM_PROMPT_NET_CHECKPOINT=model-pkg/medsam/vertebraprompt_net_auxiliar_best.pt
MEDSAM_BOX_REFINER_CHECKPOINT=model-pkg/medsam/box_refiner_best.pt
MEDSAM_SAM_CHECKPOINT=model-pkg/sam_vit_b_01ec64.pth
MEDSAM_FINETUNED_CHECKPOINT=model-pkg/medsam/medsam_decoder_encoder_parcial_entrenado_vertebraprompt_aux.pt

# Límites
MAX_UPLOAD_MB=50
INFERENCE_TIMEOUT_S=60

# CORS (lista JSON)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5500","http://127.0.0.1:5500"]

# Auth (Cognito)
AUTH_ENABLED=true
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-east-1
